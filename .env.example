# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Supabase: server-only service credential
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini: server-only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google PageSpeed Insights: server-only
PAGESPEED_API_KEY=

# Cloudflare Turnstile (Optional in local dev, bypass if not configured)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server security
IP_HASH_SECRET=change-this-to-a-secure-random-secret-for-ip-hmac
DAILY_IP_AUDIT_LIMIT=2
DAILY_GLOBAL_AUDIT_LIMIT=50
REPORT_TTL_DAYS=7
